generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  member_id    String   @id
  name         String
  initials     String
  age          Int?
  sex          String?
  weight_kg    Float?   @db.Real
  height_cm    Float?   @db.Real
  resting_hr   Int?
  mhr          Int?
  phone        String?
  access_code  String?
  auth_user_id String?  @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("members")
}

model Trainer {
  id         String   @id @default(uuid())
  trainer_id String?
  email      String
  name       String?
  gym_name   String?
  branch     String?
  role       String   @default("trainer")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  synced_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("trainers")
}

model Session {
  session_id              String                    @id
  section_id              String?
  session_name            String
  trainerId               String?                   @map("trainer_id")
  startedAt               DateTime                  @map("started_at") @db.Timestamptz(6)
  endedAt                 DateTime?                 @map("ended_at") @db.Timestamptz(6)
  duration_seconds        Int?
  synced_at               DateTime                  @default(now()) @db.Timestamptz(6)
  session_athlete_summary session_athlete_summary[]
  session_packages        session_packages?

  @@map("sessions")
}

model admin_otp {
  id               Int               @id @default(autoincrement())
  user_id          Int?
  otp_code         String?           @db.VarChar(6)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  is_used          Boolean?          @default(false)
  candidate_master candidate_master? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

