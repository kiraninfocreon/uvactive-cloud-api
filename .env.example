# UV Active Cloud API — environment variables
# Copy to .env for local dev. In production, set these on the host/
# container platform directly — never commit a real .env.

# ── Core ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Service scope ─────────────────────────────────────────────────
# This is now the ONE backend for Admin Panel, Branch Portal, Trainer
# App and Member App. Leave as "all" for the single-instance DO
# deployment. Only change if you ever split a realm back out onto its
# own instance (see common/middleware/service-scope.middleware.ts for
# what each scope allows through).
SERVICE_SCOPE=all

# ── Graph point engine ───────────────────────────────────────────────
# Tuning for the Trainer App's adaptive graph-point uploads and how
# long the raw per-second log is kept before nightly purge. Defaults
# below match what shipped in uvactive-cloud-api-v2. See
# ARCHITECTURE.md "Graph point interval" before changing these —
# GRAPH_MAX_GAP_MS / GRAPH_MIN_DELTA_BPM change what gets uploaded and
# RAW_READING_RETENTION_DAYS changes how long raw data can still be
# recalculated from, both trade against storage/bandwidth.
GRAPH_MAX_GAP_MS=15000
GRAPH_MIN_DELTA_BPM=4
GRAPH_MAX_CHART_POINTS=400
RAW_READING_RETENTION_DAYS=14

# ── Database ───────────────────────────────────────────────────────
# Postgres connection string. IMPORTANT when running multiple API
# replicas (see "Scaling to many members/trainers" below): each
# replica opens its own Prisma connection pool (default 
# num_physical_cpus*2+1 connections). Total connections across ALL
# replicas must stay under Postgres's max_connections, or add
# ?connection_limit=N to this URL to cap each replica's pool
# explicitly (e.g. ?connection_limit=10 for 5 replicas against a
# max_connections=100 database, leaving headroom for migrations/admin
# tools). Consider PgBouncer in front of Postgres once replica count
# grows past a handful.
DATABASE_URL="postgresql://user:password@localhost:5432/uvactive?schema=public"

# Rate limiting (login attempts + the global request throttler) is
# backed by a table in this same database (see
# src/common/utils/pg-rate-limit.util.ts) — no separate Redis instance
# to provision. This is correct out of the box across any number of
# replicas, nothing to set here.

# ── Auth — JWT signing secrets (REQUIRED, no defaults) ───────────────
# One secret per realm (member / staff / admin) so a leaked token from
# one realm can't be replayed against another. Each must be 16+ chars
# — the app refuses to boot otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_MEMBER_SECRET=
JWT_STAFF_SECRET=
JWT_ADMIN_SECRET=

# Access token lifetime, in minutes, per realm. Refresh token lifetime
# in days, shared across realms.
ACCESS_TOKEN_TTL_MEMBER_MIN=60
ACCESS_TOKEN_TTL_STAFF_MIN=15
ACCESS_TOKEN_TTL_ADMIN_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# TOTP issuer name shown in authenticator apps for Admin/Branch 2FA.
TOTP_ISSUER=UVActive

# Google Identity Services client ID — enables the "Sign in with
# Google" button on the Branch Portal staff login. Leave unset to
# disable that button (staff can still log in with email/password);
# the server won't crash on missing config either way.
GOOGLE_STAFF_CLIENT_ID=

# ── Push / SMS / Email notifications ──────────────────────────────────
# Expo push access token — required for actual phone-level push
# notifications to reach the Trainer App / Member App (session
# reminders, results-ready, cancellations, etc). Without this set,
# notifications still create in-app bell entries but never reach the
# device as a system push. Get one from https://expo.dev (Access
# Tokens, under your project's settings) — this is the EXPO ACCOUNT
# token, not a per-device push token (those are collected from the
# apps themselves and stored per-member/trainer in the DB).
EXPO_PUSH_ACCESS_TOKEN=

# SMS provider API key (used for critical low-frequency sends only —
# credential delivery, PIN resets). Leave unset to disable SMS; the
# corresponding notification just isn't sent (email/in-app still are).
SMS_PROVIDER_API_KEY=

# Resend (https://resend.com) — transactional email provider. Leave
# unset in dev/test: every "email" notification degrades to a
# console-logged stub instead of failing.
RESEND_API_KEY=
# Must be a verified sender on the Resend account/domain — Resend
# rejects sends from an unverified address.
RESEND_FROM_EMAIL="UV Active <onboarding@resend.dev>"

# ── Branding ───────────────────────────────────────────────────────
# Publicly reachable image URL used in the header of every branded
# HTML email (notifications/email-template.ts). Email clients can't
# load a bundled repo asset, so this has to be hosted somewhere public
# (S3/CDN/image host). *** Currently defaults to a placeholder
# (https://iili.io/CSYLcnn.jpg) that predates the UV Active falcon
# mark now used across both portals (src/assets/uv-falcon-logo.svg in
# branch-portal / admin-panel-updated) — export that SVG to a PNG,
# host it somewhere public, and set this var so branded emails match
# the in-app logo. ***
EMAIL_LOGO_URL=

# ── Object storage (member/trainer photo uploads) ─────────────────────
# S3-compatible storage (AWS S3, DigitalOcean Spaces, Cloudflare R2,
# etc). All five must be set together for photo upload to work — left
# unset, upload endpoints return a clear "storage not configured"
# error rather than a confusing failure.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Branch Portal / Admin
# Panel web apps. "*" (the default) allows any origin — fine for early
# development, tighten this to your real portal domains in production,
# e.g.: CORS_ORIGINS=https://branch.uvactive.app,https://admin.uvactive.app
CORS_ORIGINS=*

# ── Scaling to many gyms / members / trainers ─────────────────────────
# This API is stateless by design (JWT auth, no server-side sessions,
# no in-memory data — rate limiting lives in Postgres, see above) and
# ships as a Docker container (see Dockerfile) with a migration step
# that's already safe for multiple containers booting concurrently
# (scripts/migrate-deploy-locked.cjs uses a Postgres advisory lock so
# two replicas starting at once don't race on the same migration).
# Every gym/branch is just rows in the same multi-tenant schema (Gym,
# Member, Trainer, Session all key off gymId) — adding gyms doesn't
# need per-tenant infrastructure, only more capacity for the shared
# Postgres and, once volume warrants it, more replicas of this same
# container behind the load balancer (instance_count in
# infra/do-app-platform.yaml). There is no separate in-process "worker"
# mode to enable, and adding one (e.g. Node's cluster module or PM2
# cluster mode) inside a single container would just duplicate what
# container-level replicas already do more cleanly. What DOES need
# attention as replica count grows: size DATABASE_URL's
# connection_limit so replicas × per-replica pool size stays under
# Postgres's max_connections (see the DATABASE_URL comment above).
